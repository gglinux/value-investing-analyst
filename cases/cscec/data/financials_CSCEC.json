  "spike_notes": {
    "2017.ocf": "地产调控升级，存货与应收占款增加，OCF 由 +1,070 亿转为 -434.6 亿（垫资模式对回款节奏高度敏感）",
    "2018.ocf": "回款恢复转正（+103 亿），2017 低基数所致",
    "2019.ocf": "基建/地产开发投入扩大，OCF 再度转负 -342.2 亿",
    "2020.ocf": "疫情错峰复工 + 年末回款突击，OCF 转正 +202.7 亿，2019 低基数所致",
    "2020.capex": "新基建+内循环投资窗口扩张，购建支出 205 亿→495 亿（+142%）",
    "2021.ocf": "地产资金链收紧前夜，OCF 降至 +139.9 亿（-31%，未触发±50%）",
    "2022.ocf": "地产暴雷潮（恒大等）回款恶化，OCF 降至 +38.3 亿（-73%）",
    "2023.ocf": "回款修复至 +110.3 亿（+188%，2022 低基数）"
  },
  "data_notes": {
    "capex": "2024/2025 取自 SSE 已审财务报表原文（A级，filings/20260418_4BAL.pdf 同步下载）；2016-2023 与 Yahoo Finance 序列及网搜逐年核对一致（B级）",
    "d_and_a": "2018-2021取年报现金流量补充资料原文（A级，filings/cscec_2019_annual.pdf p276 & cscec_2021_annual.pdf p333）；2022-2025取Yahoo Finance年度序列（B级，衔接平滑）；2016-2017取华泰研报序列（B级，与2018 A级衔接平稳）",
    "total_assets": "接口无 TotalAssets 字段，以 TotalLiability+TotalShareholderEquity 推导（定义恒等）",
    "equity_caliber": "**口径纪律（本案关键）**：`total_equity` 按引擎勾稽要求填全口径（含少数股东权益），因 total_assets 由 负债+全口径权益 推导；但中国建筑少数股东权益占全口径权益约 40%（2025 年 3,310 亿，主要为中海地产等非全资子公司），故 series.roe / series.bvps 为全口径，**估值与股东回报判断一律引用底稿新增的 `roe_parent` / `bvps_parent`（归母口径）**：2025 年归母 ROE 8.2%（全口径 4.9%）、归母 BVPS 11.90 元（全口径 19.91 元）。误用全口径 BVPS 会把 PB-ROE 锚高估 67%。"
  },
