 "spike_notes": {
  "2013.net_income": "1,500 vs 53（+2730%）：2012 年 IPO 一次性费用（SBC ~1.8B）压低基数；移动广告货币化启动（News Feed ads 2012 下半年上线），业务正常加速——年报 MD&A 确认",
  "2013.ocf": "+162% 同上：净利基数效应 + 现金回收随广告收入放大",
  "2014.net_income": "+96%：移动端收入占比 2014 年达 66%（vs 2013 49%，年报 MD&A），WhatsApp/Oculus 并购不影响当年利润（19,000M 对价大部分为股权）",
  "2014.ocf": "+74% 与净利同源",
  "2014.total_equity": "+133%：2014-03 190M 股增发 + WhatsApp（15,222M）/Oculus（2,003M）股权对价入账，官方 10-K 股本变动表",
  "2016.net_income": "+177%（3,688→10,217）：①15% 税率低基数（2015 年 42% 递延税释放为一次性费用压低 2015 净利）；②视频广告（Facebook Live/Audience Network）收入 +54%，年报 MD&A 确认 2016 有效税率 15%（2015 42%）",
  "2016.ocf": "+56% 与净利同源",
  "2016.capex": "+78%（2,523→4,491）：数据中心与网络基础设施扩建（Luleå/Clonee 数据中心），年报 MD&A 资本开支章节",
  "2017.net_income": "+56%：美国 TCJA 税改 2017Q4 一次性收益（递延税负债重估 2.3B 减费用），叠加广告业务 +47%",
  "2017.ocf": "+50% 与净利同源",
  "2018.capex": "+107%（6,733→13,915）：数据中心/服务器/租赁资产扩张加速（年报 MD&A：2018 资本开支主要为数据中心、服务器、网络基础设施及办公设施）",
  "2020.net_income": "+58%（18,485→29,146）：疫情电商红利（广告主线上转移），有效税率降 12.2%（vs 2019 21.7%）+ 收入 +22%（正常化后增速 ~25%），需求前置——2022-11-09 裁员信官方承认该红利被误判为永久",
  "2014.revenue": "收入 +58%（7,872→12,466）：移动广告货币化爆发年——移动广告收入占比首超 50% 且广告加载率提升 + WhatsApp/FB 移动使用时长迁移；为业务变化而非数据修正（10-K 2014 原文：移动广告收入贡献约 69%）",
  "2016.revenue": "收入 +54%（17,928→27,638）：视频广告（Facebook Live/视频 feed）加载率快速提升 + Instagram 广告全面商业化（2015-09 开放）+ 目标客户自助广告工具扩张；为业务变化而非数据修正（10-K 2016 披露收入同比 +54% 由广告曝光 +61% 驱动）",
  "2013.revenue": "收入 +55%（5,089→7,872）：移动广告货币化起飞年——News Feed 信息流广告加载率持续提升 + 移动 DAU 占比首次过半；为业务变化而非数据修正（10-K 2013：广告收入 +57% 由曝光 +42% 与单价 +10% 共同驱动）"
 },
